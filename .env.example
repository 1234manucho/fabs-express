# Required production configuration. Supply real values; no accounts or business data are seeded.
APP_ENV=production
SECRET_KEY=
DATA_ENCRYPTION_KEY=
DATABASE_URL=
REDIS_URL=
PUBLIC_BASE_URL=
TRUST_PROXY=true

# Verified company details displayed on the site and documents.
LEGAL_NAME=
BUSINESS_ADDRESS=
TAX_PIN=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# SMTP delivery is required for email verification and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false

# LIVE Safaricom Daraja credentials only. Never put these in HTML or JavaScript.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# LIVE DPO credentials. Use a service type approved for logistics/shipping.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_CALLBACK_SECRET=

# Contracted map provider XYZ tile URL (with {z}/{x}/{y}) and required attribution.
# MAP_ORIGIN must be the exact HTTPS tile origin, with no path or wildcard.
MAP_TILE_URL=
MAP_ATTRIBUTION=
MAP_ORIGIN=
GPS_RETENTION_DAYS=30
